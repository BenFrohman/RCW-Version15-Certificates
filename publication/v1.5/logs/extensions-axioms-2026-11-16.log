corollaryF1 : ∀ (p q : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        5 ≤ p →
          5 ≤ q →
            (p ^ 2 * q + 12).totient = (p ^ 2 * q).totient + 12 →
              (ArithmeticFunction.sigma 1) (p ^ 2 * q + 12) = (ArithmeticFunction.sigma 1) (p ^ 2 * q) + 12 →
                Squarefree (p ^ 2 * q + 12) →
                  4 ≤ (p ^ 2 * q + 12).primeFactors.card →
                    p = 7 ∧ 7 ≤ (p ^ 2 * q + 12).primeFactors.card ∧ (p ^ 2 * q + 12).primeFactors.card ≤ 9
